{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "IS_BUILDING=true vite build",
    "analyze": "ANALYZE=true IS_BUILDING=true vite build",
    "start": "vinext start",
    "lint": "vinext lint",
    "check": "vinext check",
    "typegen": "vinext typegen",
    "preview": "npm run pre-deploy && vinext start",
    "deploy": "npm run pre-deploy && npx @vinext/cloudflare deploy",
    "pre-deploy": "IS_BUILDING=true vite build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check-size": "wrangler deploy -c dist/server/wrangler.json --outdir boundled/ --dry-run",
    "optimize-images": "cfni-image-optimizer"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.1",
    "cloudflare-next-intl": "^0.10.30",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "markdown-to-jsx": "^8.0.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.2",
    "postcss": "^8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "vercel": "^48.6.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "type": "module"
}
